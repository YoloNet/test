class SSHAuthLogger:
    """Separate logger for SSH authentication attempts"""
    def __init__(self):
        self.init_auth_database()
    
    def init_auth_database(self):
        """Initialize SSH auth logging database"""
        try:
            conn = sqlite3.connect(DB_FILE)
            cursor = conn.cursor()
            cursor.execute('''
                CREATE TABLE IF NOT EXISTS ssh_auth_attempts (
                    id INTEGER PRIMARY KEY AUTOINCREMENT,
                    connection_id INTEGER,
                    real_ip TEXT,
                    username TEXT,
                    password_hash TEXT,
                    auth_method TEXT,
                    auth_result TEXT,
                    timestamp DATETIME,
                    session_id TEXT,
                    FOREIGN KEY(connection_id) REFERENCES connections(id)
                )
            ''')
            conn.commit()
            conn.close()
        except Exception as e:
            print(f"[AUTH-DB] Auth database initialization error: {e}")
    
    def log_auth_attempt(self, connection_id, real_ip, username, password, auth_method, result, session_id):
        """Log SSH authentication attempt"""
        try:
            # Hash password for security (never store plaintext)
            password_hash = hashlib.sha256(password.encode()).hexdigest()[:16] if password else None
            
            # Database logging
            conn = sqlite3.connect(DB_FILE)
            cursor = conn.cursor()
            cursor.execute('''
                INSERT INTO ssh_auth_attempts 
                (connection_id, real_ip, username, password_hash, auth_method, auth_result, timestamp, session_id)
                VALUES (?, ?, ?, ?, ?, ?, ?, ?)
            ''', (connection_id, real_ip, username, password_hash, auth_method, result, datetime.now(), session_id))
            conn.commit()
            conn.close()
            
            # File logging
            auth_entry = f"[{datetime.now().strftime('%Y-%m-%d %H:%M:%S')}] SSH_AUTH - IP: {real_ip} | User: {username} | Method: {auth_method} | Result: {result} | Session: {session_id}\n"
            with open(AUTH_LOG_FILE, "a") as f:
                f.write(auth_entry)
            
            print(f"[SSH-AUTH] {real_ip} - User: {username} - {result}")
            
        except Exception as e:
            print(f"[AUTH-LOG] Auth logging error: {e}")

class SSHProtocolParser:
    """Parse SSH protocol packets to extract authentication data"""
    
    def __init__(self, auth_logger, connection_id, real_ip):
        self.auth_logger = auth_logger
        self.connection_id = connection_id
        self.real_ip = real_ip
        self.session_id = f"ws_{int(time.time())}_{hash(real_ip) % 10000}"
        self.auth_phase = False
        self.username = None
        self.buffer = b""
        
    def parse_ssh_packet(self, data, direction):
        """Parse SSH protocol packets for authentication info"""
        try:
            if not data:
                return data
            
            # Add to buffer for packet reconstruction
            self.buffer += data
            
            # Look for SSH protocol packets
            if direction == "CLIENT->SSH":
                self.parse_client_packets()
            elif direction == "SSH->CLIENT":
                self.parse_server_packets()
            
            return data
            
        except Exception as e:
            print(f"[SSH-PARSER] Parsing error: {e}")
            return data
    
    def parse_client_packets(self):
        """Parse packets from client to SSH server"""
        try:
            while len(self.buffer) >= 4:
                # SSH packet format: [4 bytes length][1 byte padding][payload]
                if len(self.buffer) < 4:
                    break
                
                # Extract packet length (first 4 bytes, big-endian)
                try:
                    packet_length = struct.unpack('>I', self.buffer[:4])[0]
                except struct.error:
                    # Not a valid SSH packet, look for patterns instead
                    self.parse_text_patterns()
                    break
                
                # Check if we have complete packet
                if len(self.buffer) < packet_length + 4:
                    break
                
                # Extract complete packet
                packet = self.buffer[4:packet_length + 4]
                self.buffer = self.buffer[packet_length + 4:]
                
                if len(packet) > 0:
                    # Parse SSH message type
                    msg_type = packet[0] if isinstance(packet[0], int) else ord(packet[0])
                    self.handle_ssh_message(msg_type, packet[1:])
                    
        except Exception as e:
            # If structured parsing fails, try text-based parsing
            self.parse_text_patterns()
    
    def parse_text_patterns(self):
        """Parse authentication using text patterns (fallback method)"""
        try:
            # Convert buffer to string for pattern matching
            text_data = self.buffer.decode('utf-8', errors='ignore')
            
            # Look for SSH authentication patterns
            auth_patterns = [
                # OpenSSH authentication request patterns
                r'ssh-userauth.*?(\w+)',
                # Password authentication
                r'password.*?([a-zA-Z0-9_\-\.]+)',
                # Username patterns
                r'user[:\s]+([a-zA-Z0-9_\-\.]+)',
                # Specific SSH protocol strings
                r'ssh-connection.*?([a-zA-Z0-9_\-\.]+)',
            ]
            
            for pattern in auth_patterns:
                matches = re.findall(pattern, text_data, re.IGNORECASE)
                if matches:
                    for match in matches:
                        if len(match) > 2 and match not in ['ssh', 'connection', 'userauth']:
                            if not self.username:
                                self.username = match
                                print(f"[SSH-PARSER] Detected username attempt: {match}")
            
            # Clear processed buffer
            self.buffer = self.buffer[-1024:]  # Keep last 1KB for context
            
        except Exception as e:
            print(f"[SSH-PARSER] Text pattern parsing error: {e}")
    
    def handle_ssh_message(self, msg_type, payload):
        """Handle specific SSH message types"""
        try:
            # SSH message types (RFC 4252)
            SSH_MSG_USERAUTH_REQUEST = 50
            SSH_MSG_USERAUTH_SUCCESS = 52
            SSH_MSG_USERAUTH_FAILURE = 51
            
            if msg_type == SSH_MSG_USERAUTH_REQUEST:
                self.parse_userauth_request(payload)
            elif msg_type == SSH_MSG_USERAUTH_SUCCESS:
                if self.username:
                    self.auth_logger.log_auth_attempt(
                        self.connection_id, self.real_ip, self.username, 
                        "", "password", "SUCCESS", self.session_id
                    )
            elif msg_type == SSH_MSG_USERAUTH_FAILURE:
                if self.username:
                    self.auth_logger.log_auth_attempt(
                        self.connection_id, self.real_ip, self.username,
                        "", "password", "FAILURE", self.session_id
                    )
                    
        except Exception as e:
            print(f"[SSH-PARSER] Message handling error: {e}")
    
    def parse_userauth_request(self, payload):
        """Parse SSH userauth request packet"""
        try:
            if len(payload) < 4:
                return
            
            # SSH string format: [4 bytes length][string data]
            offset = 0
            
            # Extract username
            if offset + 4 <= len(payload):
                username_len = struct.unpack('>I', payload[offset:offset+4])[0]
                offset += 4
                if offset + username_len <= len(payload):
                    username = payload[offset:offset+username_len].decode('utf-8', errors='ignore')
                    offset += username_len
                    self.username = username
                    
                    # Extract service name
                    if offset + 4 <= len(payload):
                        service_len = struct.unpack('>I', payload[offset:offset+4])[0]
                        offset += 4 + service_len
                        
                        # Extract method name
                        if offset + 4 <= len(payload):
                            method_len = struct.unpack('>I', payload[offset:offset+4])[0]
                            offset += 4
                            if offset + method_len <= len(payload):
                                method = payload[offset:offset+method_len].decode('utf-8', errors='ignore')
                                
                                print(f"[SSH-PARSER] Auth attempt - User: {username}, Method: {method}")
                                
                                # If it's password authentication, extract password
                                if method == "password":
                                    offset += method_len + 1  # Skip method and boolean
                                    if offset + 4 <= len(payload):
                                        pass_len = struct.unpack('>I', payload[offset:offset+4])[0]
                                        offset += 4
                                        if offset + pass_len <= len(payload) and pass_len < 256:  # Reasonable password length
                                            password = payload[offset:offset+pass_len].decode('utf-8', errors='ignore')
                                            
                                            # Log the authentication attempt
                                            self.auth_logger.log_auth_attempt(
                                                self.connection_id, self.real_ip, username,
                                                password, method, "ATTEMPT", self.session_id
                                            )
                                            
        except Exception as e:
            print(f"[SSH-PARSER] Userauth parsing error: {e}")
    
    def parse_server_packets(self):
        """Parse packets from SSH server to client"""
        # For now, just clear the buffer since we mainly need client auth data
        self.buffer = self.buffer[-512:]  # Keep small buffer for context

class ConnectionLogger:
    def __init__(self):
        self.init_database()
    
    def init_database(self):
        """Initialize SQLite database for connection logging"""
        try:
            conn = sqlite3.connect(DB_FILE)
            cursor = conn.cursor()
            cursor.execute('''
                CREATE TABLE IF NOT EXISTS connections (
                    id INTEGER PRIMARY KEY AUTOINCREMENT,
                    real_ip TEXT,
                    proxy_ip TEXT,
                    user_agent TEXT,
                    connection_type TEXT,
                    timestamp DATETIME,
                    bytes_sent INTEGER DEFAULT 0,
                    bytes_received INTEGER DEFAULT 0,
                    duration INTEGER DEFAULT 0,
                    status TEXT DEFAULT 'active'
                )
            ''')
            conn.commit()
            conn.close()
        except Exception as e:
            print(f"[DB] Database initialization error: {e}")
    
    def log_connection(self, real_ip, proxy_ip, user_agent, connection_type):
        """Log new connection to database and file"""
        try:
            # Database logging
            conn = sqlite3.connect(DB_FILE)
            cursor = conn.cursor()
            cursor.execute('''
                INSERT INTO connections (real_ip, proxy_ip, user_agent, connection_type, timestamp)
                VALUES (?, ?, ?, ?, ?)
            ''', (real_ip, proxy_ip, user_agent, connection_type, datetime.now()))
            connection_id = cursor.lastrowid
            conn.commit()
            conn.close()
            
            # File logging
            log_entry = f"[{datetime.now().strftime('%Y-%m-%d %H:%M:%S')}] NEW_CONNECTION - Real IP: {real_ip} | Proxy IP: {proxy_ip} | Type: {connection_type} | User-Agent: {user_agent[:100]}\n"
            with open(LOG_FILE, "a") as f:
                f.write(log_entry)
            
            print(f"[LOG] Connection logged - ID: {connection_id}, Real IP: {real_ip}")
            return connection_id
            
        except Exception as e:
            print(f"[LOG] Logging error: {e}")
            return None
    
    def update_connection_stats(self, connection_id, bytes_sent, bytes_received, duration):
        """Update connection statistics"""
        try:
            conn = sqlite3.connect(DB_FILE)
            cursor = conn.cursor()
            cursor.execute('''
                UPDATE connections 
                SET bytes_sent = ?, bytes_received = ?, duration = ?, status = 'completed'
                WHERE id = ?
            ''', (bytes_sent, bytes_received, duration, connection_id))
            conn.commit()
            conn.close()
        except Exception as e:
            print(f"[LOG] Stats update error: {e}")

class UniversalConnectionHandler(threading.Thread):
    def __init__(self, client, addr, logger, auth_logger):
        super().__init__()
        self.client = client
        self.addr = addr
        self.logger = logger
        self.auth_logger = auth_logger
        self.daemon = True
        self.connection_id = None
        self.start_time = time.time()
        self.bytes_sent = 0
        self.bytes_received = 0
        self.ssh_parser = None
        
    def run(self):
        try:
            # Read initial data from client
            initial_data = self.client.recv(BUFLEN)
            if not initial_data:
                return
                
            request_str = initial_data.decode('utf-8', errors='ignore')
            
            # Extract real IP and other info from headers
            real_ip, user_agent, connection_type = self.extract_client_info(request_str)
            
            # Log the connection
            self.connection_id = self.logger.log_connection(
                real_ip, str(self.addr[0]), user_agent, connection_type
            )
            
            # Initialize SSH parser for authentication tracking
            self.ssh_parser = SSHProtocolParser(self.auth_logger, self.connection_id, real_ip)
            
            print(f"\n[{real_ip}] ({self.addr}) Received {connection_type} payload:")
            print("-" * 50)
            print(request_str[:400])  # Show first 400 chars
            print("-" * 50)
            
            # Determine payload type and handle accordingly
            self.handle_universal_payload(request_str, initial_data)
                
        except Exception as e:
            print(f"[{self.addr}] Connection error: {e}")
        finally:
            # Update final statistics
            if self.connection_id:
                duration = int(time.time() - self.start_time)
                self.logger.update_connection_stats(
                    self.connection_id, self.bytes_sent, self.bytes_received, duration
                )
            try:
                self.client.close()
            except:
                pass
    
    def extract_client_info(self, request_str):
        """Extract real IP address and other client info from HTTP headers"""
        real_ip = str(self.addr[0])  # Fallback to proxy IP
        user_agent = "Unknown"
        connection_type = "Unknown"
        
        # Check for real IP in various headers (Caddy typically uses these)
        headers_to_check = [
            r'x-forwarded-for:\s*([^\r\n,]+)',
            r'x-real-ip:\s*([^\r\n]+)',
            r'cf-connecting-ip:\s*([^\r\n]+)',  # Cloudflare
            r'x-client-ip:\s*([^\r\n]+)',
            r'x-cluster-client-ip:\s*([^\r\n]+)'
        ]
        
        for header_pattern in headers_to_check:
            match = re.search(header_pattern, request_str, re.IGNORECASE)
            if match:
                potential_ip = match.group(1).strip()
                # Take first IP if comma-separated
                if ',' in potential_ip:
                    potential_ip = potential_ip.split(',')[0].strip()
                # Validate IP format
                if self.is_valid_ip(potential_ip):
                    real_ip = potential_ip
                    break
        
        # Extract User-Agent
        ua_match = re.search(r'user-agent:\s*([^\r\n]+)', request_str, re.IGNORECASE)
        if ua_match:
            user_agent = ua_match.group(1).strip()
        
        # Determine connection type
        if self.is_enhanced_websocket_payload(request_str):
            connection_type = "Enhanced-WebSocket"
        elif 'upgrade: websocket' in request_str.lower():
            connection_type = "WebSocket"
        elif request_str.startswith('CONNECT'):
            connection_type = "HTTP_TUNNEL"
        elif any(request_str.startswith(method) for method in ['GET', 'POST', 'PUT', 'HEAD']):
            connection_type = "HTTP"
        else:
            connection_type = "RAW"
        
        return real_ip, user_agent, connection_type
    
    def is_valid_ip(self, ip):
        """Basic IP address validation"""
        try:
            parts = ip.split('.')
            if len(parts) != 4:
                return False
            for part in parts:
                if not 0 <= int(part) <= 255:
                    return False
            # Exclude private/local IPs for real IP detection
            if ip.startswith(('127.', '10.', '192.168.', '172.')):
                return False
            return True
        except:
            return False
    
    def is_enhanced_websocket_payload(self, request_str):
        """Detect enhanced WebSocket payloads with multiple requests"""
        # Look for patterns like GET-RAY, RNG-RAY, or multiple HTTP requests
        enhanced_patterns = [
            r'GET-RAY\s+/',
            r'RNG-RAY\s+/',
            r'GET\s+/[^\r\n]+\r\nHost:[^\r\n]+\r\n\r\n(?:GET|POST|PUT|HEAD|GET-RAY|RNG-RAY)',
            r'upgrade:\s*websocket:[^\r\n]+',  # Enhanced WebSocket with domain
        ]
        
        for pattern in enhanced_patterns:
            if re.search(pattern, request_str, re.IGNORECASE):
                return True
        return False
    
    def extract_websocket_request(self, request_str):
        """Extract the WebSocket upgrade request from enhanced payloads"""
        try:
            # Split by double CRLF to separate multiple requests
            requests = re.split(r'\r\n\r\n', request_str)
            
            for req in requests:
                # Look for WebSocket upgrade headers
                if 'upgrade: websocket' in req.lower() or 'connection: upgrade' in req.lower():
                    # Extract the request line and headers
                    lines = req.split('\r\n')
                    request_line = lines[0] if lines else ""
                    
                    # Check if it's a valid request line (GET, GET-RAY, RNG-RAY, etc.)
                    if any(req.startswith(method) for method in ['GET ', 'GET-RAY ', 'RNG-RAY ', 'POST ', 'PUT ']):
                        # Reconstruct the WebSocket request
                        websocket_request = req
                        return websocket_request
            
            # If no clear WebSocket request found, return the last request
            return requests[-1] if requests else request_str
            
        except Exception as e:
            print(f"[{self.addr}] Error extracting WebSocket request: {e}")
            return request_str
                
    def handle_universal_payload(self, request_str, raw_data):
