        ).encode()
    
    def pipe_data_with_parsing(self, src, dst, direction, is_outbound):
        """Pipe data between sockets with SSH protocol parsing and byte counting"""
        bytes_transferred = 0
        try:
            while True:
                ready = select.select([src], [], [], TIMEOUT)
                if ready[0]:
                    data = src.recv(BUFLEN)
                    if not data:
                        break
                    
                    # Parse SSH data if parser is available
                    if self.ssh_parser:
                        parsed_data = self.ssh_parser.parse_ssh_packet(data, direction)
                        dst.sendall(parsed_data)
                    else:
                        dst.sendall(data)
                    
                    bytes_transferred += len(data)
                    
                    # Update byte counters
                    if is_outbound:
                        self.bytes_sent += len(data)
                    else:
                        self.bytes_received += len(data)
                else:
                    # Timeout occurred
                    break
        except Exception as e:
            print(f"[{self.addr}] {direction} pipe error: {e}")
        finally:
            print(f"[{self.addr}] {direction} transferred: {bytes_transferred} bytes")
            try:
                src.shutdown(socket.SHUT_RD)
            except:
                pass
            try:
                dst.shutdown(socket.SHUT_WR)
            except:
                pass

